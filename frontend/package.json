{
  "name": "deployer-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite-ssg build",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src tests vite.config.ts",
    "lint:fix": "oxlint --fix src tests vite.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@heroicons/vue": "^2.2.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1"
}
